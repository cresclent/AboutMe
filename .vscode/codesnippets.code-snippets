      "}",
      "",
      "input[type=\"text\"],",
      "input[type=\"number\"],",
      "select {",
      "    background-color: var(--night-25);",
      "    border: 1px solid var(--silver-dim);",
      "    border-radius: 5px;",
      "    margin-top: 5px;",
      "    height: 25px;",
      "    padding: 0 0.4rem;",
      "    color: var(--text);",
      "}",
      "",
      "option {",
      "    background-color: var(--night);",
      "    color: var(--text);",
      "}",
      "",
      ".topmargin    { margin-top: 20px; }",
      ".bottommargin { margin-bottom: 20px; }",
      "",
      ".column {",
      "    display: flex;",
      "    flex-direction: column;",
      "    gap: 5px;",
      "}",
      "",
      ".row {",
      "    display: flex;",
      "    flex-direction: row;",
      "    gap: 5px;",
      "    flex-wrap: wrap;",
      "}",
      "",
      ".between {",
      "    display: flex;",
      "    flex-direction: row;",
      "    justify-content: space-between;",
      "    align-items: center;",
      "}",
      "",
      ".chonk   { font-weight: bold; }",
      ".unchonk { font-weight: normal; }",
      "",
      "${0}",
