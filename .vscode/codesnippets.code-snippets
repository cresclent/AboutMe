      "    width: var(--table-sub-width);",
      "}",
      "",
      "form {",
      "    display: flex;",
      "    flex-direction: column;",
      "    align-items: center;",
      "    gap: 10px;",
      "}",
      "",
      "input:not([type=\"checkbox\"], [type=\"radio\"], [type=\"submit\"]) {",
